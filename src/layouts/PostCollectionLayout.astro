---
import BaseLayout from '@layouts/BaseLayout.astro';
import PostCategories from '@components/PostCategories.astro';

interface CollectionInfo {
  total: number;
  start?: number;
  end?: number;
}

const { title, collection } = Astro.props;
const { total, start=0, end=total-1 } = collection;
const isPartial = start>0 || end<total-1;
---
<BaseLayout {...Astro.props}>
  <section>

    <div
      class={`content-section wrapper${Astro.props.hasCategoriesNav ? " center-info-area" : ""}`}
      style="--_content--gap:0.5rem;"
    >
      <h1>{title}</h1>
      { Astro.props.hasCategoriesNav && <PostCategories /> }
      <div class="info"><slot name="info" /></div>  {/* Collection Info */}
      {
        total>0 &&
        <p>
          {isPartial
            ? `Showing ${start + 1}-${end + 1} of ${total}`
            : total
          } {total === 1 ? 'Entry' : 'Entries'}
        </p>
      }
    </div>

    <div class="wrapper card shadow-sm surface0">
      <slot name="content" />  {/* Collection Content */}
    </div>

  </section>
</BaseLayout>


<style>
  .center-info-area h1 {
    font-size: clamp(
      var(--_font-size),
      8vw,
      calc(var(--_font-size) * 1.5)
    );
  }
  .center-info-area h1,
  .center-info-area p {
    margin-inline: auto;
    text-align: center;
  }

  .info { margin-bottom: 1rem; }
  .info:empty { display: none; }
</style>
