
---
/**
 * NOTE: This page is a duplicate of the content
 * that would be generated by the [category]/1/ page.
 * The PaginationButtons component explicitly links to page 1,
 * whereas all other links link to the unpaginated URL.
 * The paginated page 1 is given a meta robots noindex tag.
 */

import { getCollection } from 'astro:content';
import PostCollectionLayout from '@layouts/PostCollectionLayout.astro';
import { SITE_AUTHOR, POSTS_PER_PAGE, POSTS_ARCHIVE } from '@consts';
import { firstPage } from '@utils/pagination';
import { getPostCategory, getCategoryLabel } from '@utils/categories';
import ExpandedPreviewCard from '@components/PostPreviewCard/ExpandedPreviewCard.astro';
import CompactPreviewCard from '@components/PostPreviewCard/CompactPreviewCard.astro';
import NothingHereCard from '@components/PostPreviewCard/NothingHereCard.astro';
import PaginationButtons from '@components/PaginationButtons.astro';

export async function getStaticPaths() {

  // Get Published Posts, Sorted by Date Descending
  const publishedPosts = (await getCollection('posts'))
    .filter(post => !post.data.hidden)
    .sort((a, b) =>
      Date.parse(b.data.dateUpdated || b.data.datePublished) -
      Date.parse(a.data.dateUpdated || a.data.datePublished)
    );

  // Get Categories (including Archive)
  const categories = [
    POSTS_ARCHIVE.slug,
    ...new Set(publishedPosts.map(post => getPostCategory(post.id)).sort()),
  ];

  // Generate a Page for Each Category
  return categories.map(category => {
    const isArchive = category === POSTS_ARCHIVE.slug;

    return {
      params: { category },
      props: {
        formattedCategory: isArchive
          ? POSTS_ARCHIVE.title
          : getCategoryLabel(category),
        categorizedPosts: isArchive
          ? publishedPosts
          : publishedPosts.filter(post => getPostCategory(post.id) === category),
      },
    };
  });
}

// Get Page Properties
const { formattedCategory, categorizedPosts } = Astro.props;

// Build First Page Pagination
const page = firstPage(categorizedPosts, POSTS_PER_PAGE);
const visiblePosts = categorizedPosts.slice(0, POSTS_PER_PAGE);

const cardHeadingLevel = 'h2';
---

<PostCollectionLayout
  title={formattedCategory}
  description={`${SITE_AUTHOR}'s ${formattedCategory}`}
  hasCategoriesNav={true}
  collection={page}
>
  <div
    slot="content"
    class="content-section"
  >

    {/* No Posts - Nothing Here Card */}
    {
      visiblePosts.length === 0 &&
      <NothingHereCard />
    }

    {/* Most Recent Post - Large Card */}
    {
      visiblePosts.length > 0 &&
      <ExpandedPreviewCard post={visiblePosts[0]} headingLevel={cardHeadingLevel} />
    }

    {/* Posts 2+ - Medium Card */}
    {
      visiblePosts.length > 1 &&
      <ul class="layout layout--grid">
        {
          visiblePosts.slice(1).map(post => (
            <li>
              <CompactPreviewCard post={post} headingLevel={cardHeadingLevel} />
            </li>
          ))
        }
      </ul>
    }

    <PaginationButtons
      page={page}
      baseUrl={Astro.url.pathname.split('/').filter(Boolean).join('/')}
    />
  </div>
</PostCollectionLayout>
