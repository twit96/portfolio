---
interface Props {
  headingLevel?: 'h2' | 'h3';
  href: string;
}

const { headingLevel='h3', href } = Astro.props;
const Heading = headingLevel;
---
{
  href && (
    <Heading class="card-title">
      <a href={href}><slot /></a>
    </Heading>
  )
}

<style>
  /* force h3 font-size from global styles */
  .card-title { --_font-size: 1.5rem; }
</style>
