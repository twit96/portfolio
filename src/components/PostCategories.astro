---
import { getCollection } from 'astro:content';
import { POSTS_ARCHIVE } from '@consts';
import { getPostCategory, getCategoryLabel } from '../utils/categories';

// Get Published Categories
const publishedPosts = (await getCollection('posts')).filter(post => !post.data.hidden);
const categories = [...new Set(publishedPosts.map(post => getPostCategory(post.id)))].sort();

// Get Current Category
const currentCategory = Astro.url.pathname.split('/').filter(Boolean)[0];

// Build Category Navigation
const categoryLinks = [
  {
    text: POSTS_ARCHIVE.navLabel,
    href: `/${POSTS_ARCHIVE.slug}/`,
    isActive: currentCategory === POSTS_ARCHIVE.slug,
  },
  ...categories.map(category => ({
    text: getCategoryLabel(category),
    href: `/${category}/`,
    isActive: category === currentCategory,
  })),
];
---

<nav
  class="content-section"
  style="--_content--gap:0.5rem;"
>
  <h2 class="heading--diminished">Filter Posts by Category</h2>
  <ul
    class="btns layout layout--flex-fill"
    style="--_layout--base-size:auto; --_layout--gap:0.125rem;"
  >
    {categoryLinks.map(({ text, href, isActive }) =>
      <li>
        <a
          href={href}
          aria-current={isActive ? 'true' : undefined}
          class={`btn ${isActive ? 'surfaceAction' : 'surface2'}`}
        >
          {text}
        </a>
      </li>
    )}
  </ul>
</nav>

<style>
  nav {
    margin-block: 0.5rem 1rem;
    margin-inline: auto;
    text-align: center;
  }
  a {
    display: block;
    text-decoration: none;
  }
  a[aria-current] { text-decoration: underline; }
</style>
